# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bms
POSTGRES_USER=bms_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://bms_user:change_me@localhost:5432/bms

# API
PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_32_plus_character_random_secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Web
VITE_API_URL=http://localhost:4000/api

# Optional one-time local admin seeding (do not commit real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_12_plus_character_local_password
ADMIN_FULL_NAME=System Administrator
